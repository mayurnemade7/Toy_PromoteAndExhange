{
  "name": "toy-exchange-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Toy Promote & Exchange \u2014 Company Monorepo",
  "scripts": {
    "dev": "turbo dev",
    "dev:dashboard": "turbo dev --filter=@toy-exchange/agile-dashboard",
    "dev:frontend": "turbo dev --filter=@toy-exchange/frontend",
    "dev:backend": "turbo dev --filter=@toy-exchange/backend",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.34.5"
}